' Gambas class file

' ============================================
' Formulario: FMain
' Propósito : Vista maestro-detalle del corpus normativo. La aplicación
'             es un instrumento de LECTURA y PULIDO: permite consultar,
'             navegar el grafo de relaciones y corregir el texto de las
'             entradas, pero NO da de alta ni elimina entradas ni
'             familias. Esas son decisiones sobre el corpus y se aplican
'             por script SQL, no desde la interfaz.
'             Los handlers son delgados: toda la lógica vive en m_Base,
'             m_Corpus, m_Relaciones y m_Exportar.
' ============================================

' --- BANDERA DE CARGA: SUPRIME LOS EVENTOS QUE DISPARA LA PROPIA UI ---
' ASIGNAR .Index O .Text POR CÓDIGO LEVANTA Click Y Change; SIN ESTA
' BANDERA, CARGAR UNA ENTRADA LA MARCARÍA COMO MODIFICADA
Private $bCargando As Boolean

' --- ESTADO DE LA VISTA ---
Private $bModificado As Boolean
Private $aRelaciones As New CRelacion[]
Private $aHistorial As New String[]

' --- ÍNDICE DEL FILTRO EFECTIVAMENTE APLICADO ---
' NO SE DERIVA DE LA ENTRADA EN CURSO: CON LOS FILTROS ANALÍTICOS
' (pendientes, sin verificar, no vigentes) NO HAY FAMILIA DE LA CUAL
' DERIVARLO. SE RECUERDA EL ÚLTIMO ÍNDICE VÁLIDO PARA PODER RESTAURARLO
' CUANDO EL USUARIO CANCELA UN DESCARTE DE CAMBIOS.
Private $iFiltroEnCurso As Integer

' ============================================
' Función   : Form_Open
' Propósito : Arranque en orden fail-fast: infraestructura, configuración,
'             interfaz.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Open()

  ' --- 1. INFRAESTRUCTURA: SIN BASE NO HAY APLICACIÓN ---
  If Not m_Base.Conectar() Then
    ' m_Base YA INFORMÓ LA CAUSA CONCRETA
    Quit
  Endif

  ' --- 2. GEOMETRÍA GUARDADA Y TÍTULO ---
  Settings.Read(Me)
  Me.Text = "Corpus normativo — " & m_Base.RutaArchivoBase()

  ' --- 3. PROPORCIÓN DE LOS DOS PANELES ---
  ' SE FIJA UNA SOLA VEZ. CALCULARLA EN UN HANDLER Resize LA RECOMPUTA
  ' EN CADA CUADRO DEL ARRASTRE, SIN NINGUNA GANANCIA
  hspPrincipal.Layout = [1, 2]

  ' --- 4. LISTAS FIJAS DE LOS COMBOS DE METADATOS ---
  CargarCombosFijos()

  ' --- 5. FILTROS Y ENTRADAS ---
  CargarComboFiltros()
  RefrescarLista(m_Corpus.FILTRO_TODAS)

  ' --- 6. ESTADO INICIAL DE CONTROLES ---
  LimpiarDetalle()
  ActualizarBotones()

End

' ============================================
' Función   : Form_Close
' Propósito : Guard de cambios sin guardar antes de cerrar (SC-06) y
'             liberación explícita de la conexión.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Close()

  ' --- 1. GUARD: LA SALIDA ES UN CAMBIO DE CONTEXTO MÁS ---
  If Not ConfirmarDescartarCambios() Then
    Stop Event
    Return
  Endif

  ' --- 2. LIBERACIÓN EXPLÍCITA: NO SE DELEGA EN Finally (RC-GM-20) ---
  Settings.Write(Me)
  m_Base.Cerrar()

End

' ============================================
' Función   : cmbFamilia_Click
' Propósito : Cambia el filtro del ListBox principal. El combo mezcla
'             familias con filtros analíticos sobre el corpus entero;
'             el control conserva el nombre cmbFamilia por compatibilidad
'             con el .form.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbFamilia_Click()

  Dim sFiltro As String

  ' --- 1. EVENTO DISPARADO POR CÓDIGO: NO ES ACCIÓN DEL USUARIO ---
  If $bCargando Then Return

  ' --- 2. GUARD DE CAMBIOS SIN GUARDAR ---
  If Not ConfirmarDescartarCambios() Then
    RestaurarSeleccionFiltro()
    Return
  Endif

  ' --- 3. RECARGA DE LA LISTA CON EL NUEVO FILTRO ---
  sFiltro = m_Corpus.FiltroDeIndice(cmbFamilia.Index)
  RefrescarLista(sFiltro)

  ' --- 4. EL FILTRO QUEDA ACEPTADO: SE RECUERDA PARA PODER RESTAURARLO ---
  $iFiltroEnCurso = cmbFamilia.Index

  LimpiarDetalle()
  ActualizarBotones()

End

' ============================================
' Función   : lstEntradas_Click
' Propósito : Muestra la entrada seleccionada en el panel de detalle
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub lstEntradas_Click()

  Dim sCodigo As String

  ' --- 1. EVENTO DISPARADO POR CÓDIGO ---
  If $bCargando Then Return

  ' --- 2. GUARD DE CAMBIOS SIN GUARDAR ---
  If Not ConfirmarDescartarCambios() Then
    RestaurarSeleccionEntrada()
    Return
  Endif

  ' --- 3. CARGA DEL DETALLE ---
  sCodigo = m_Corpus.CodigoDeIndice(lstEntradas.Index)
  If sCodigo = "" Then Return

  MostrarEntrada(sCodigo)

End

' ============================================
' Función   : lstRelaciones_Click
' Propósito : Salta a la entrada del otro extremo del vínculo, apilando
'             la actual para que el botón Volver tenga a dónde volver.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub lstRelaciones_Click()

  Dim iIndice As Integer
  Dim oVinculo As CRelacion
  Dim sOrigen As String

  ' --- 1. EVENTO DISPARADO POR CÓDIGO ---
  If $bCargando Then Return

  ' --- 2. VALIDACIÓN DE RANGO ---
  iIndice = lstRelaciones.Index
  If iIndice < 0 Then Return
  If iIndice >= $aRelaciones.Count Then Return

  oVinculo = $aRelaciones[iIndice]

  ' --- 3. UN VÍNCULO MUERTO SE MUESTRA PERO NO SE NAVEGA ---
  If oVinculo.bRota Then
    Message.Warning("El código " & oVinculo.sCodigo & " no existe en el corpus." & Chr(10) &
      "Corregir el campo Relaciones de esta entrada.")
    Return
  Endif

  ' --- 4. GUARD DE CAMBIOS SIN GUARDAR ---
  If Not ConfirmarDescartarCambios() Then Return

  ' --- 5. APILADO DEL ORIGEN Y SALTO ---
  sOrigen = m_Corpus.CodigoEnCurso
  If sOrigen <> "" Then $aHistorial.Add(sOrigen)

  SeleccionarCodigo(oVinculo.sCodigo)

End

' ============================================
' Función   : btnAtras_Click
' Propósito : Deshace el último salto por relaciones
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnAtras_Click()

  Dim sCodigo As String

  ' --- 1. VALIDACIÓN: PILA VACÍA ---
  If $aHistorial.Count = 0 Then Return

  ' --- 2. GUARD DE CAMBIOS SIN GUARDAR ---
  If Not ConfirmarDescartarCambios() Then Return

  ' --- 3. DESAPILADO ---
  sCodigo = $aHistorial[$aHistorial.Max]
  $aHistorial.Remove($aHistorial.Max)

  SeleccionarCodigo(sCodigo)

End

' ============================================
' Función   : btnGuardar_Click
' Propósito : Valida y persiste la entrada en curso. Es la única
'             escritura que la aplicación hace sobre el corpus.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardar_Click()

  Dim oEntrada As CEntrada
  Dim sDesconocidos As String
  Dim sCodigo As String

  ' --- 1. VALIDACIÓN: DEBE HABER ENTRADA EN CURSO ---
  sCodigo = m_Corpus.CodigoEnCurso
  If sCodigo = "" Then
    Message.Info("No hay ninguna entrada seleccionada.")
    Return
  Endif

  ' --- 2. VALIDACIÓN: EL TÍTULO ES LO QUE SE VE EN LA LISTA ---
  If Trim$(txtTitulo.Text) = "" Then
    Message.Warning("El título no puede quedar vacío.")
    txtTitulo.SetFocus()
    Return
  Endif

  ' --- 3. VALIDACIÓN: NINGÚN VÍNCULO PUEDE APUNTAR A LA NADA ---
  sDesconocidos = m_Relaciones.ValidarRelaciones(txtRelaciones.Text)
  If sDesconocidos <> "" Then
    Message.Warning("Estos códigos no existen en el corpus:" & Chr(10) &
      sDesconocidos & Chr(10) & Chr(10) &
      "Corregirlos antes de guardar.")
    txtRelaciones.SetFocus()
    Return
  Endif

  ' --- 4. VOLCADO DE LA UI AL OBJETO ---
  oEntrada = m_Corpus.LeerEntrada(sCodigo)
  If IsNull(oEntrada) Then
    Message.Error("La entrada " & sCodigo & " ya no está en la base.")
    Return
  Endif

  oEntrada.sTitulo = Trim$(txtTitulo.Text)
  oEntrada.sCuerpo = txaCuerpo.Text
  oEntrada.sEstado = cmbEstado.Text
  oEntrada.sEvidencia = cmbEvidencia.Text
  oEntrada.sEntorno = Trim$(txtEntorno.Text)
  oEntrada.sFechaVerificacion = Trim$(txtFecha.Text)
  oEntrada.sRelaciones = Trim$(txtRelaciones.Text)
  oEntrada.sPendiente = Trim$(txtPendiente.Text)

  ' --- 5. PERSISTENCIA ---
  If Not m_Corpus.GuardarEntrada(oEntrada) Then Return

  $bModificado = False

  ' --- 6. LA LÍNEA DE LA LISTA PUDO CAMBIAR: TÍTULO O ESTADO ---
  ' Y CON LOS FILTROS ANALÍTICOS LA ENTRADA PUEDE HABER DEJADO DE
  ' CUMPLIR EL CRITERIO: SI YA NO ESTÁ EN LA LISTA, SeleccionarCodigo
  ' ABRE EL FILTRO A TODO EL CORPUS
  RefrescarLista(m_Corpus.FiltroDeIndice(cmbFamilia.Index))
  SeleccionarCodigo(sCodigo)

  ActualizarBotones()

End

